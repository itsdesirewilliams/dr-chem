# DR-Chem — application environment template.
#
# Copy this file to `.env` and fill in real values (`.env` is git-ignored).
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env

# --- Database ----------------------------------------------------------------

# Standard PostgreSQL connection string used by the application.
# Provider-agnostic: point it at any PostgreSQL server — currently Supabase
# (hosted), later any self-hosted or managed PostgreSQL instance.
#
# Supabase fields:
#   USER     ->  e.g. postgres.<project-ref>
#   PASSWORD ->  the database password from Supabase Dashboard > Settings > Database
#   HOST     ->  e.g. aws-0-<region>.pooler.supabase.com  (or your direct host)
#   PORT     ->  5432
#   DATABASE ->  e.g. postgres
#
# `sslmode=require` is mandatory for Supabase and valid for any TLS-enabled
# PostgreSQL; omit it only for a plain non-TLS local/self-hosted server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Website (public) configuration -------------------------------------------
# All NEXT_PUBLIC_* values are embedded in the client bundle at build time.
# They contain no secrets.

# Canonical public origin, used for links/OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in E.164 digits with country code, NO "+", spaces
# or dashes. Leave blank until the official number is provided — CTAs fall
# back to email until then.
#   e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Official contact email (source: drchem.co.in/contact-us).
NEXT_PUBLIC_CONTACT_EMAIL=marketing@drchem.co.in

# DR-Chem's only official social presence (source: company LinkedIn page).
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/drchemicals
