# DR-Chem — local Docker & PostgreSQL environment template.
#
# Usage:
#   1. Copy this file to the project root as `.env`  (or keep it in `docker/`
#      and start Compose with `--env-file docker/.env`).
#      PowerShell:  Copy-Item docker/.env.example .env
#      macOS/Linux: cp docker/.env.example .env
#   2. Replace POSTGRES_PASSWORD with a strong, generated value.
#      Example: openssl rand -hex 32   (or `python -c "import secrets; print(secrets.token_hex(32))"`)
#   3. Do NOT commit the real `.env` file; it is already git-ignored.

# Database name created on first start.
POSTGRES_DB=drchem

# Database owner/administrator role created on first start.
POSTGRES_USER=drchem

# Database password. REQUIRED — generate a strong random value before starting.
# This is only applied when the data volume is first initialized; changing it
# later has no effect on an existing volume.
POSTGRES_PASSWORD=generate-a-strong-password-here

# Host port the database is published on (loopback only). Leave as 5432 unless
# the port is already in use on this machine.
POSTGRES_PORT=5432